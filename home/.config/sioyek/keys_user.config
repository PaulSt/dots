# Page navigation: center the destination while keeping the current zoom.
next_page;_center_page              J
previous_page;_center_page          K

# Pan the viewport left/right, matching the arrow keys.
# Sioyek names these commands by the direction the document moves.
move_right                         h
move_left                          l

# Browser-like location history
prev_state                         H
next_state                         L

# Highlighting (h is used for panning).
add_highlight                      <C-h>

# View modes: z = zoom/view
fit_to_page_width_smart            zw
fit_to_page_height                 zh
toggle_dark_mode                   zd
toggle_custom_color                zc
toggle_horizontal_scroll_lock      zl
toggle_synctex                     zs

# Double-page view and even/odd spread alignment
toggle_two_page_mode                zp
toggleconfig_recto_verso_adjustment  zP

# Reference navigation using the visual ruler
enter_visual_mark_mode             vv
close_visual_mark                  vc
synctex_under_ruler                vs
close_visual_mark;keyboard_select  V
goto_definition                    gd
overview_definition                go
portal_to_definition               gp

open_document_embedded_from_current_path o
open_prev_doc                      O
